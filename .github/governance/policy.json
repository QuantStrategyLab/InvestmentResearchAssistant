{
  "version": "pr-governance/v3",
  "mode": "enforce",
  "review_routing": {
    "dispatch_mentions": [
      "@codex review",
      "@claude review"
    ]
  },
  "r0_paths": [
    "README.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/"
  ],
  "r2_paths": [
    ".github/governance/",
    ".github/workflows/",
    "schema/",
    "adapters/"
  ],
  "dependabot_template_exemption": true,
  "max_evidence_age_hours": 168
}
